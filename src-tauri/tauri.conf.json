{
  "productName": "Sample Curator",
  "version": "0.1.7",
  "identifier": "com.music-hub.sample-curator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' asset: https://asset.localhost; connect-src 'self' asset: https://asset.localhost ipc: http://ipc.localhost; img-src 'self' asset: https://asset.localhost data: blob:; media-src 'self' asset: https://asset.localhost blob: data:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "Sample Curator",
        "width": 1200,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/chronick/sample-curator/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDNzI3QTExQjk2OTRGMEIKUldRTFQybTVFWHB5dlB4M0Nvb1NqeTlCR0pQRjdjYjJkY1hnVGkrZ2tqUmVHVXgxSytvUTJDVzAK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "minimumSystemVersion": "15.0"
    },
    "resources": {
      "../sidecar/dist/sample-curation-api/": "sidecar/",
      "resources/uv": "uv",
      "resources/runtime-pyproject.toml": "runtime-pyproject.toml",
      "../sidecar/ml_worker.py": "ml_worker.py"
    },
    "shortDescription": "",
    "targets": "all",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
