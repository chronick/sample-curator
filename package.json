{
  "name": "@music-hub/sample-curator",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && cd sidecar && uv sync --python 3.11",
    "start": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:dev": "tsc && vite build",
    "tauri:build:dev": "tauri build --config src-tauri/tauri.dev.conf.json",
    "resources:fetch": "bash scripts/fetch-uv.sh",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "npm run resources:fetch && tauri build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "sidecar:sync": "cd sidecar && uv sync --python 3.11",
    "sidecar:sync:full": "cd sidecar && uv sync --python 3.11 --extra fingerprint --extra segmentation",
    "sidecar:bundle": "cd sidecar && uv sync --python 3.11 --extra bundle && uv run pyinstaller sample-curation-api.spec --clean --noconfirm",
    "sidecar:test": "cd sidecar && uv run pytest",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cd src-tauri && cargo test",
    "test:rust:coverage": "cd src-tauri && cargo llvm-cov --summary-only",
    "test:python": "cd sidecar && uv run pytest -v --tb=short",
    "test:python:coverage": "cd sidecar && uv run pytest --cov=sample_curation_api --cov-report=term-missing -v --tb=short",
    "test:all": "npm run test:coverage && npm run test:rust:coverage && npm run test:python:coverage"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.0.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.172.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.11.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/three": "^0.172.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^5.0.10",
    "vitest": "^4.0.18",
    "ws": "^8.19.0"
  }
}
