{
  "name": "@music-hub/sample-curator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && cd sidecar && uv sync --python 3.11",
    "start": "tauri dev",
    "dev": "vite",
    "build": "tsc && vite build && tauri build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "sidecar:sync": "cd sidecar && uv sync --python 3.11",
    "sidecar:sync:full": "cd sidecar && uv sync --python 3.11 --extra fingerprint --extra segmentation",
    "sidecar:test": "cd sidecar && uv run pytest",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.0.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.172.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/three": "^0.172.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^4.0.18"
  }
}
